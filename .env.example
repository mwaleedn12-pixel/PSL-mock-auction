# =========================================================================
# PSL 12 Live Mock Auction Manager: Environment Variables
# =========================================================================
# Copy this file to .env.local for local testing:
# cp .env.example .env.local
#
# Also add these exact keys to your Vercel Project Dashboard:
# Vercel -> Project -> Settings -> Environment Variables
# =========================================================================

# 1. Your Supabase Project URL (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon Public API Key (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
